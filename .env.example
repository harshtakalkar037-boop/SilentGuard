# SilentGuard runs with no credentials, no API keys and no accounts.
# This file exists only for local run-time overrides. Copy to .env if needed.
#
# There is no secret in this project. If a fork ever adds one, it belongs
# here as a name only - never a value.

# Path to an alternate configuration file.
# SILENTGUARD_CONFIG=./src/silentguard/config/config.yaml

# Set to 1 for verbose library logging in demos.
# SILENTGUARD_DEBUG=0
